<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portfólio - José Roberto</title>
    <!-- Ícones do Google Fonts -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" />
    
    <style>
        /* Configurações Gerais */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Fundo escuro */
        body {
            background: linear-gradient(135deg, #0a192f 0%, #000000 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            color: #ffffff;
            padding: 20px;
        }

        /* O Cartão Principal */
        .card {
            background: rgba(255, 255, 255, 0.05);
            border: 2px solid #009c3b; /* Verde Brasil */
            border-radius: 20px;
            padding: 30px;
            width: 100%;
            max-width: 380px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 156, 59, 0.2);
        }

        /* Foto de Perfil */
        .foto-perfil {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            border: 4px solid #ffdf00; /* Amarelo Brasil */
            object-fit: cover;
            margin-bottom: 15px;
            background-color: #002776; /* Azul Brasil */
        }

        /* Nome */
        h1 {
            font-size: 26px;
            color: #ffffff;
            margin-bottom: 5px;
        }

        /* Cargo */
        .cargo {
            font-size: 14px;
            color: #ffdf00; /* Amarelo Brasil */
            margin-bottom: 25px;
            font-weight: 600;
            letter-spacing: 1px;
        }

        /* Botões */
        .menu {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .menu a {
            text-decoration: none;
            color: #ffffff;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid #009c3b; /* Verde */
            padding: 12px;
            border-radius: 10px;
            font-size: 16px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        /* Efeito ao passar o mouse */
        .menu a:hover {
            background: #002776; /* Azul Brasil */
            border-color: #ffdf00; /* Amarelo */
            transform: translateY(-2px);
        }

        /* Redes Sociais */
        .redes-sociais {
            margin-top: 25px;
            display: flex;
            justify-content: center;
            gap: 15px;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            padding-top: 20px;
        }

        .redes-sociais a {
            color: #ffffff;
            text-decoration: none;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            transition: 0.3s;
        }

        .redes-sociais a:hover {
            background: #ffdf00; /* Amarelo */
            color: #000000;
        }

        /* Rodapé */
        footer {
            margin-top: 30px;
            font-size: 12px;
            color: #666;
        }
    </style>
</head>
<body>

    <div class="card">
        <!-- FOTO: Coloquei um avatar padrão, mas você pode trocar o link por uma foto sua se quiser -->
        <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=Jose" alt="Foto de José Roberto" class="foto-perfil">
        
        <h1>José Roberto</h1>
        <p class="cargo">Desenvolvedor Front-end</p>
        
        <div class="menu">
            <a href="#">Sobre mim</a>
            <a href="#">Projetos</a>
            <a href="#">Certificados</a>
        </div>

        <div class="redes-sociais">
            <!-- Substitua o "#" pelo link do seu GitHub/LinkedIn se tiver -->
            <a href="https://github.com/ribamarfilho053-web" title="GitHub">
                <span class="material-symbols-outlined">code</span>
            </a>
            <a href="#" title="LinkedIn">
                <span class="material-symbols-outlined">work</span>
            </a>
            <a href="#" title="Email">
                <span class="material-symbols-outlined">mail</span>
            </a>
        </div>
    </div>

    <footer>Programa Trilhas • 2026</footer>

</body>
</html>
